@model Donation

@{
    ViewData["Title"] = "Edit donation";
}

<h1>Edit donation</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="SupporterId" class="form-label"></label>
                <select asp-for="SupporterId" asp-items="ViewBag.Supporters" class="form-select">
                    <option value="">-- Select a supporter --</option>
                </select>
                <span asp-validation-for="SupporterId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DonatedOn" class="form-label"></label>
                <input asp-for="DonatedOn" class="form-control" />
                <span asp-validation-for="DonatedOn" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
